<?xml version="1.0" ?>
<mujoco model="four_wheel_robot">
  <compiler angle="radian" coordinate="local"/>
  <default>
    <joint damping="0.1" frictionloss="0.1"/>
    <geom friction="1.0 0.1 0.1" density="1000"/>
  </default>
  <asset/>
  <worldbody>
    <geom name="ground" type="plane" size="10 10 0.1" rgba="0.8 0.8 0.8 1"/>
    <body name="obstacle" pos="2 0 0.1">
      <geom name="obstacle_geom" type="box" size="0.1 0.1 0.1" rgba="1 0 0 1"/>
    </body>
    <body name="robot" pos="0 0 0.1">
      <joint name="root_free" type="free"/>
      <geom name="base_link_visual" type="box" size="0.2 0.15 0.05" rgba="0.2 0.2 0.8 1.0"/>
      <body name="front_left_wheel" pos="0.15 0.18 -0.05">
        <geom name="front_left_wheel_visual" type="cylinder" size="0.05 0.015" rgba="0.1 0.1 0.1 1.0"/>
        <joint name="front_left_wheel_joint" type="hinge" axis="0 1 0"/>
      </body>
      <body name="front_right_wheel" pos="0.15 -0.18 -0.05">
        <geom name="front_right_wheel_visual" type="cylinder" size="0.05 0.015" rgba="0.1 0.1 0.1 1.0"/>
        <joint name="front_right_wheel_joint" type="hinge" axis="0 1 0"/>
      </body>
      <body name="rear_left_wheel" pos="-0.15 0.18 -0.05">
        <geom name="rear_left_wheel_visual" type="cylinder" size="0.05 0.015" rgba="0.1 0.1 0.1 1.0"/>
        <joint name="rear_left_wheel_joint" type="hinge" axis="0 1 0"/>
      </body>
      <body name="rear_right_wheel" pos="-0.15 -0.18 -0.05">
        <geom name="rear_right_wheel_visual" type="cylinder" size="0.05 0.015" rgba="0.1 0.1 0.1 1.0"/>
        <joint name="rear_right_wheel_joint" type="hinge" axis="0 1 0"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="front_left_wheel_joint_motor" joint="front_left_wheel_joint" gear="1"/>
    <motor name="front_right_wheel_joint_motor" joint="front_right_wheel_joint" gear="1"/>
    <motor name="rear_left_wheel_joint_motor" joint="rear_left_wheel_joint" gear="1"/>
    <motor name="rear_right_wheel_joint_motor" joint="rear_right_wheel_joint" gear="1"/>
  </actuator>
</mujoco>
